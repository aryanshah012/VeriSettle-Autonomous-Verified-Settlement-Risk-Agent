# Database Configuration (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/indocrypt?schema=public"

# --- Telegraph Protocol Hackathon Track 3 Configuration ---
# Competition Mode:
#   "live"   -> Queries the live Telegraph decentralized miner network with x402 payment protocol.
#   "mock"   -> Offline deterministic mode for local unit testing without network credentials.
TELEGRAPH_MODE="live"
NEXT_PUBLIC_TELEGRAPH_MODE="live"

# Telegraph Node / Engine Endpoints
TELEGRAPH_API_BASE="http://13.237.89.59:8080"
TELEGRAPH_ENGINE_URL="http://13.237.89.59:8080"
TELEGRAPH_NODE_URL="http://13.237.89.59:7044"
TELEGRAPH_API_KEY=""

# x402 Payment Authorization Wallet Private Key (EVM / Solana)
# Required by the official Telegraph x402 client to sign HTTP 402 payment challenges (e.g. EIP-3009 USDC authorization)
X402_PRIVATE_KEY=""
TELEGRAPH_EVM_PRIVATE_KEY=""
